# Pearlecent website
DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private folders and files are never served
  RewriteRule ^(inc|data|dev)(/|$) - [F,L]
  RewriteRule (^|/)\.(git|env|ht) - [F,L]
  # Keep the old .html addresses working
  RewriteRule ^index\.html$ index.php [L]
  RewriteRule ^about\.html$ about.php [L]
  RewriteRule ^treatments\.html$ treatments.php [L]
  RewriteRule ^dentists/([a-z0-9-]+)\.html$ dentist.php?slug=$1 [L,QSA]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-journal|json|key|md|py|cjs|sh|log|bak|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
